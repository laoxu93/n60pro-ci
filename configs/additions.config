# Force-enable packages (applied on top of base config)
# laoxu93 custom: OpenClash + Lucky + AdGuardHome
# dnsmasq-full / kmod-tun / ttyd / wol / ddns / upnp are already
# enabled in base.config, so not repeated here.

# --- Proxy: OpenClash ---
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_kmod-tun=y

# --- ip-full: required by OpenClash, conflicts with ip-tiny ---
# ip-tiny is disabled via configs/blacklist.txt
CONFIG_PACKAGE_ip-full=y

# --- NAT traversal / DDNS: Lucky ---
CONFIG_PACKAGE_luci-app-lucky=y

# --- DNS adblock: AdGuardHome ---
CONFIG_PACKAGE_luci-app-adguardhome=y

# --- Theme ---
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# --- Image size limit ---
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_PARTSIZE=112